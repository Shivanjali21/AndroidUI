<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivAndroid"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/android"
            android:layout_marginVertical="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivChristmas"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/christmas"
            android:layout_marginVertical="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivAndroid"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivFood"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/food"
            android:layout_marginVertical="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivChristmas"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivHNY"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/happynewyear"
            android:layout_marginVertical="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivFood"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="20dp"
            android:layout_marginHorizontal="20dp"
            android:text="@string/tap_on_a_icon"
            android:textColor="@color/color_white"
            android:fontFamily="@font/poppinssemibold"
            android:includeFontPadding="false"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:background="@color/color_orange"
            app:layout_constraintTop_toBottomOf="@id/ivHNY"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>